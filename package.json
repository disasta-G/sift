{
  "name": "sift",
  "version": "0.1.0",
  "description": "Fast local full-text and substring search for your notes, with operators, path and date filters.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx test/fixtures/generate.ts",
    "bench": "tsx scripts/benchmark.ts",
    "guard": "node scripts/scope-guard.mjs",
    "preview": "node dev/preview/build.mjs && node dev/preview/serve.mjs",
    "check": "npm run guard && npm run typecheck && npm run lint && npm test",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "Dario Giovanoli",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.16.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fake-indexeddb": "^6.2.0",
    "happy-dom": "^20.0.0",
    "obsidian": "1.8.7",
    "tslib": "^2.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
